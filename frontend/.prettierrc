{
  "useTabs": false,
  "semi": true,
  "tabWidth": 2,
  "singleQuote": false,
  "trailingComma": "none",
  "arrowParens": "always",
  "singleAttributePerLine": false,
  "printWidth": 120,
  "proseWrap": "always",
  "bracketSpacing": true,
  "plugins": ["prettier-plugin-tailwindcss"]
}
